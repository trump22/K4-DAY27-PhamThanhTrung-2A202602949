# LLM provider (OpenRouter is OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# SQLite database path (optional — defaults to ./hitl_audit.db in CWD)
# HITL_DB_PATH=hitl_audit.db

# GitHub Personal Access Token — REQUIRED.
#
# The agent calls the GitHub REST API directly. Generate a token at:
#   https://github.com/settings/tokens/new
# Scopes: tick `public_repo` (enough for VinUni-AI20k/PR-Demo — it's a public repo).
#
# Posting a top-level PR comment works for any authenticated user on a public repo.
# Formal reviews (Approve/Request-changes) would need collaborator status on the target.
GITHUB_TOKEN=

# Reviewer identity recorded for human decisions
GITHUB_USER=your-github-username

# Optional Gemini OpenAI-compatible configuration (reuse OPENROUTER_API_KEY for the Google key):
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional request timeout in seconds (default 120).
# LLM_TIMEOUT_SECONDS=90
# Optional only when the chosen provider/model supports reasoning_effort.
# LLM_REASONING_EFFORT=low
